 "story": {
  "intro": {
   "title": "The Wyrm's Graveyard",
   "speaker": "Old Warden",
   "text": "Every fire you have put out was lit from here. The Emberwyrm sleeps under the old crypts, and a Rift Golem keeps the gate.\n\nBreak the golem, hold the yard, and the wyrm will come to you."
  },
  "outro": {
   "title": "The Long Dawn",
   "speaker": "Old Warden",
   "text": "The wyrm falls across the graves it guarded. For the first time in a year, the sun comes up without smoke.\n\nRest. The road is yours."
  }
 }
