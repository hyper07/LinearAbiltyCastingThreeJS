{
  "name": "gamory",
  "version": "1.0.0",
  "private": true,
  "description": "Gamory \u2014 spells, stories and worlds you build. Three.js action RPG with AI-designed classes, a shared content library, and co-op play in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/library/ensure.mjs",
    "build": "vite build",
    "postbuild": "node scripts/precompress.mjs",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "serve": "node server/server.js",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "fetch-characters": "node scripts/fetch-character-models.mjs",
    "library:fetch": "node scripts/library/fetch.mjs",
    "library:index": "node scripts/library/index.mjs",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.mjs",
    "game:new": "node --disable-warning=ExperimentalWarning scripts/new-game.mjs",
    "work:images": "node scripts/work/scene-images.mjs",
    "geo:seoul": "node scripts/geo/seoul-build.mjs",
    "db:import": "node --disable-warning=ExperimentalWarning scripts/db-import.mjs",
    "kb": "node scripts/kb.mjs",
    "kb:build": "node scripts/kb-pixelfx.mjs && node scripts/kb-build.mjs",
    "library:polyfork": "node scripts/library/polyfork.mjs",
    "modelgen:setup": "node scripts/modelgen-setup.mjs",
    "modelgen:local": "node scripts/modelgen-local.mjs",
    "music:setup": "node scripts/music-setup.mjs",
    "music:gen": "node scripts/music-gen.mjs",
    "music:soundtrack": "node scripts/music-soundtrack.mjs",
    "music:preview": "node scripts/music-preview.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@fontsource-variable/nunito": "^5.3.0",
    "lil-gui": "^0.21.0",
    "pg": "8.23.1",
    "three": "^0.185.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
