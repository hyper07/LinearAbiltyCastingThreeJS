# Gamory — AI model settings
#
# Copy this file to `.env` (same folder), then edit the values:
#
#     macOS / Linux:   cp .env.example .env
#     Windows (PS):    Copy-Item .env.example .env
#     Windows (cmd):   copy .env.example .env
#
# `.env` is git-ignored, so your real settings never get committed. Restart
# `npm run dev` after every change — Vite only reads this file at startup.
#
# Without a working model the game still runs: the chat panel shows
# "reflex only" and falls back to simple keyword commands.

# ---- LM Studio ---------------------------------------------------------------
# 1. In LM Studio, download a model (e.g. Qwen3 4B) and load it.
# 2. Open the Developer tab and start the server (default port 1234).
#    To reach it from another computer on your network, also turn on
#    "Serve on Local Network" and use that computer's IP address below.
# 3. Keep the trailing /v1.
#
#   Same computer:          http://127.0.0.1:1234/v1
#   Another computer (LAN): http://192.168.1.50:1234/v1
#   From Docker Compose:    http://host.docker.internal:1234/v1
LLM_PLATFORM_BASE_URL=http://127.0.0.1:1234/v1

# LM Studio needs no key unless you turned on authentication in its server
# settings. Leave it blank otherwise; any non-empty value is sent as a
# Bearer token by the dev server / bridge, never to the browser.
LLM_API_KEY=

# The model identifier exactly as LM Studio shows it (Developer tab, or
# http://127.0.0.1:1234/v1/models). A small, fast instruct model is best:
# the game wants one short JSON answer per order.
#
# LLM_MODEL1 is the planner, used for every chat order.
LLM_MODEL1=qwen/qwen3-4b
# LLM_MODEL2 is a spare, not used by the game yet.
LLM_MODEL2=qwen/qwen3-1.7b

# ---- Optional ----------------------------------------------------------------
# How long to wait for the model on a chat order before giving up, in ms
# (default 45000). Map design asks for up to 150 s on its own.
# LLM_TIMEOUT_MS=45000

# ---- 3D asset library ----------------------------------------------------
# The first `npm run dev` downloads ~7 GB of free CC0 3D models into
# ./library in the background (and `npm run build` downloads it first).
# Set LIBRARY_AUTO_FETCH=0 to turn that off and run `npm run library:fetch`
# yourself. LIBRARY_MAX_GB caps the download (default 40).
# LIBRARY_AUTO_FETCH=0
# LIBRARY_MAX_GB=40

# ---- Your own 3D models (main menu → Create) ----------------------------
# Uploading a GLB / glTF / FBX / OBJ needs nothing. To turn a *picture* into a
# 3D model, add ONE of these keys (the cloud service charges per model, about
# $0.30 for a model, ~$0.45–0.85 for a rigged, animated character):
#   Tripo3D  https://developers.tripo3d.ai/en/keys
#   Meshy    https://www.meshy.ai/developers/keys   (needs prepaid API credits)
# TRIPO_API_KEY=
# MESHY_API_KEY=
# Force one provider when both keys are set: tripo | meshy  (mock = offline test)
# MODELGEN_PROVIDER=

# ---- Running it for players (server/server.js, docker compose) -------------
# See docs/production.md. Players per party (2–8), default 4.
# MAX_PLAYERS=4
# 1 behind a reverse proxy (nginx, Caddy, a load balancer): rate limits then
# see the real client address from X-Forwarded-For.
# TRUST_PROXY=0
# Where saved levels, classes and the content library go (default ./data).
# DATA_DIR=./data
# Model calls allowed per client address per minute (default 30).
# AI_RATE_PER_MIN=30
# The key that seals characters and chains the history (base64, 32+ bytes):
#     openssl rand -base64 48
# Unset: the server makes one in DATA_DIR/server.key. Never change it on a
# server with players — the saved characters only open with it.
# SERVER_SECRET=
# New accounts one address may make in a day (default 5).
# ACCOUNTS_PER_ADDRESS_PER_DAY=5
